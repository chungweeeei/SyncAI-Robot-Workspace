# Our own wire format: src/syncai_common, from SyncAI-Robot-Interface, managed
# with vcstool the same way third-party.repos manages src/third-party/,
# driver-manager.repos manages src/syncai_driver_manager and robot-state.repos
# manages src/syncai_robot_state.
#
#   vcs import < interface.repos          # populate a fresh clone
#   vcs import < interface.repos --force  # re-checkout after changing the pin
#
# `src/syncai_common/` is gitignored -- edit the messages in that checkout (its
# own git repo) and commit there, never here; the next --force import overwrites
# anything uncommitted.
#
# Tracks `dev`, that repo's default and working branch, since 2026-09: it used to
# say `main`, which lagged `dev` after the ResetLIO addition (PR #1 there) and
# left `vcs import` without the srv the workspace's syncai_pointlio serves.
repositories:
  src/syncai_common:
    type: git
    url: https://github.com/chungweeeei/SyncAI-Robot-Interface.git
    version: dev
