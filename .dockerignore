# Keep the docker build context small and free of secrets. The Dockerfile's
# builder stage COPYs src/ for the release image (the vcs checkouts and their
# submodules are already on disk, so nothing is cloned at build time);
# everything else here is runtime/host data that must never end up in an
# image layer.

# colcon artifacts (host-side, bind-mounted in dev; the builder stage makes
# its own, so a checkout's --symlink-install tree can never reach a release)
build/
install/
log/

# git metadata (incl. submodule .git gitlink files — useless in-image)
.git
.gitmodules
**/.git

# secrets — .env holds live credentials; images must stay secret-free
.env
**/.env
**/.env.*
!**/.env.example

# host-side service data / recordings / maps (mounted at runtime instead)
data/
record/
map/
dist/

# docs / editor / CI
doc/
.devcontainer/
.vscode/
.idea/
.claude/
.github/

# frontend build outputs (frontend has its own build context + .dockerignore)
src/syncai_frontend/node_modules/
src/syncai_frontend/.next/

# python / misc caches
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
*.log
*.bag
*.mcap
