# Production environment for the robot IPC — copy to .env next to
# docker-compose.prod.yml and fill in real values. NEVER commit the filled-in
# .env or bake it into an image.

# ── Release ──
# Image version to run; load_and_up.sh keeps this in sync with the loaded tar.
TAG=
# Which per-robot identity to mount as config/system.ini
ROBOT_ID=robot01

# ── ROS / DDS ──
ROS_DOMAIN_ID=0

# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=default

# ── Temporal (auto-setup reuses the shared postgres) ──
TEMPORAL_DB=postgres12
TEMPORAL_DB_PORT=5432
TEMPORAL_POSTGRES_SEEDS=postgres

# ── Debug profile only (temporal-ui / pgadmin) ──
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_CORS_ORIGINS=http://localhost:3001
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=change-me

# ── Backend ──
GEMINI_API_KEY=
