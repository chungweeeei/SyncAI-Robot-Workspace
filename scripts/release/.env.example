# Environment of docker-compose.release.yml on a robot. install.sh copies this
# to /opt/syncai/.env on the first install and stops until every CHANGE_ME
# below is replaced. Never commit a filled-in copy.

# ── Release ──
# The image the robot container runs, and the one it ran before. Both are
# written by install.sh (on install, update and --rollback); do not edit them
# by hand -- the compose file, config/cyclonedds.xml and the factory params
# beside this file were copied out of SYNCAI_IMAGE and belong to it.
SYNCAI_IMAGE=
SYNCAI_IMAGE_PREVIOUS=

# ── Robot ──
# The instance file mounted over config/system.ini:
# /opt/syncai/config/instances/<ROBOT_INSTANCE>.ini. The backend's compose
# mounts the same file through its own ROBOT_INSTANCE; keep the two equal.
ROBOT_INSTANCE=robot
# Host group ids of the camera and sound device nodes, which differ between
# hosts: `getent group video audio`. 44 / 29 are Ubuntu's.
VIDEO_GID=44
AUDIO_GID=29

# ── PostgreSQL ──
# The password is written into data/postgres when that directory is first
# initialised and is not changed by editing this line afterwards. The backend
# reads the same three from its own .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=default

# ── Temporal (auto-setup reuses the postgres above) ──
TEMPORAL_DB=postgres12
TEMPORAL_DB_PORT=5432
TEMPORAL_POSTGRES_SEEDS=postgres
# How far back the console's task history reaches. Read only when the
# namespace is created, on a fresh data/postgres.
TEMPORAL_NAMESPACE_RETENTION=5d
