# Camera black-border crop settings for unit 138 (measured from the actual image)
#
# The fisheye lens's circular image circle does not fully cover the rectangular
# sensor, so all four corners are occluded by black arcs. The occlusion sits in a
# different place on each of the two machines, so these numbers are per-machine
# and must not be shared.
#
# The ${VAR:-value} form is deliberate: an environment variable passed on the
# command line still wins, so trying a new value does not require editing this
# file.
CROP_LEFT="${CROP_LEFT:-175}"
CROP_RIGHT="${CROP_RIGHT:-93}"

# Capture the full sensor frame, crop off the black borders, take the largest
# 16:9 region, then scale back to 1920x1080.
SRC_WIDTH="${SRC_WIDTH:-1920}"
SRC_HEIGHT="${SRC_HEIGHT:-1200}"
OUT_WIDTH="${OUT_WIDTH:-1280}"
OUT_HEIGHT="${OUT_HEIGHT:-720}"

# Publish target (host / port / path as one set)
#
# host is the address of the remote MediaMTX server -- mediamtx does not run on
# this machine, and the script does not try to start it.
# port must match the rtspAddress in that server's mediamtx.yml (that file lives
# on the server, not in this repo).
#
# The path prefix is the machine name: several machines push to the same server,
# and without a prefix they would fight over the same path.
MEDIAMTX_RTSP_HOST="${MEDIAMTX_RTSP_HOST:-192.168.8.160}"
MEDIAMTX_RTSP_PORT="${MEDIAMTX_RTSP_PORT:-8554}"
MEDIAMTX_STREAM_PATH="${MEDIAMTX_STREAM_PATH:-dogA/camera}"

# Publish credentials: only uncomment these when the server's authInternalUsers
# requires a username/password. If this machine is admitted via the ips
# allowlist, leave them commented out -- sending an empty username counts as a
# failed authentication attempt, which is not the same as sending none at all.
# MEDIAMTX_PUBLISH_USER="${MEDIAMTX_PUBLISH_USER:-}"
# MEDIAMTX_PUBLISH_PASS="${MEDIAMTX_PUBLISH_PASS:-}"
