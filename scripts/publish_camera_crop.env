# 138 的相機黑邊裁切設定（依實際畫面量測）
#
# 魚眼鏡頭的圓形成像圈沒有完全覆蓋方形感測器，四個角落有黑色弧形遮擋，
# 兩台機器的遮擋位置不同，所以這組數字是各機器獨立的，不要共用。
#
# 寫成 ${VAR:-值} 是刻意的：命令列臨時帶的環境變數仍然優先，
# 試新數值時不必改這個檔案。
CROP_LEFT="${CROP_LEFT:-175}"
CROP_RIGHT="${CROP_RIGHT:-93}"

# 感測器全幅擷取，裁掉黑邊後取最大的 16:9，再縮放回 1920x1080
SRC_WIDTH="${SRC_WIDTH:-1920}"
SRC_HEIGHT="${SRC_HEIGHT:-1200}"
OUT_WIDTH="${OUT_WIDTH:-1920}"
OUT_HEIGHT="${OUT_HEIGHT:-1080}"

# 推流目標（host / port / path 一組）
#
# host 用 loopback 是認證需求不是偏好：config/mediamtx.yml 的 authInternalUsers
# 只允許 127.0.0.1/::1 publish，推流端永遠同機。port 要跟同一個檔案的
# rtspAddress 對上。
MEDIAMTX_RTSP_HOST="${MEDIAMTX_RTSP_HOST:-192.168.8.160}"
MEDIAMTX_RTSP_PORT="${MEDIAMTX_RTSP_PORT:-8554}"
MEDIAMTX_STREAM_PATH="${MEDIAMTX_STREAM_PATH:-dogA/camera}"
