# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=syncai

# ── pgAdmin ──
PGADMIN_DEFAULT_EMAIL=admin@syncai.com
PGADMIN_DEFAULT_PASSWORD=changeme

# ── Temporal ──
# Schema plugin + connection to the shared postgres (reuses POSTGRES_USER / POSTGRES_PASSWORD).
TEMPORAL_DB=postgres12
TEMPORAL_DB_PORT=5432
TEMPORAL_POSTGRES_SEEDS=postgres

# Temporal UI → frontend wiring
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_CORS_ORIGINS=http://localhost:3000
