# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=syncai

# ── pgAdmin ──
PGADMIN_DEFAULT_EMAIL=admin@syncai.com
PGADMIN_DEFAULT_PASSWORD=changeme

# ── Temporal ──
# Schema plugin + connection to the shared postgres (reuses POSTGRES_USER / POSTGRES_PASSWORD).
TEMPORAL_DB=postgres12
TEMPORAL_DB_PORT=5432
TEMPORAL_POSTGRES_SEEDS=postgres

# Temporal UI → frontend wiring
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_CORS_ORIGINS=http://localhost:3000

# ── WebRTC worker (libsyncai_worker.so, read by the backend's WHEP gateway) ──
# The gateway applies its own floor for these with setdefault just before
# InitWorker, so anything set here wins; the worker freezes its configuration
# under a sync.Once, which is why changing one means restarting the backend.
#
# STUN_SERVERS empty is deliberate on a LAN robot: the console and the robot
# share a subnet, so host candidates are what connect them, and a public STUN
# URL on a robot with no internet only makes ICE gathering -- which the WHEP
# POST blocks on -- wait out a timeout that can never succeed.
STUN_SERVERS=
# TURN_SERVERS=
# TURN_USERNAME=
# TURN_PASSWORD=

# Capture. The defaults below are the worker's own; override per robot.
# A resolution/framerate pair the sensor does not advertise fails as a
# not-negotiated error on the GStreamer bus -- check with
# `v4l2-ctl -d /dev/syncai/camera0 --list-formats-ext` before changing them.
# VIDEO_DEVICE=/dev/syncai/camera0
# VIDEO_FORMAT=mjpeg          # mjpeg (nvjpegdec) or uyvy (videoconvert)
# VIDEO_WIDTH=1280
# VIDEO_HEIGHT=720
# VIDEO_FRAMERATE=60
# VIDEO_BITRATE=4000000

# Sensor controls, written through v4l2src extra-controls at capture start.
# UVC control state persists in the camera firmware across open/close, so these
# are what stop a session from inheriting the last process's settings. Mind the
# polarity: VIDEO_AUTO_EXPOSURE=0 and VIDEO_AUTO_WB=1 both mean "automatic".
# VIDEO_AUTO_EXPOSURE=0        # 0 = Auto Mode, 1 = Manual Mode
# VIDEO_EXPOSURE=330           # 100 us units; only when AUTO_EXPOSURE=1
# VIDEO_AUTO_WB=1              # 1 = automatic white balance, 0 = manual
# VIDEO_WB_TEMP=5000           # Kelvin; only when AUTO_WB=0
# VIDEO_GAIN=1
# VIDEO_BRIGHTNESS=16
# VIDEO_POWER_LINE_FREQ=1      # 0 disabled, 1 = 50 Hz, 2 = 60 Hz

# WHIP playback: where the operator's microphone comes out. ALSA by card name,
# because the USB dongle's card number depends on probe order while its name
# does not. Not PulseAudio -- there is no daemon in the robot container.
# AUDIO_SINK=alsasink device=plughw:CARD=CD002AUDIO
# AUDIO_VOLUME=1.0            # unity gain; above 1.0 amplifies and clips
# AUDIO_RTP_PORT=5004

# The microphone branch, off by default: this chassis has no capture device
# and the container ships no alsasrc element. Set the whole source element,
# properties included, to enable it.
# VIDEO_AUDIO_SRC=alsasrc device=hw:2,0 do-timestamp=true
