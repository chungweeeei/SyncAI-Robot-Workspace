# ── Robot container ──
# The CycloneDDS config the robot (and recorder) containers run on, as a path
# under config/. Leave unset for config/cyclonedds.xml -- loopback only, domain
# 1, what every robot ran on until a second model arrived. A host that needs
# other DDS wiring names its file here; the backend's compose must then be
# pointed at the same file. This is not where the robot's model is set: that is
# [system] robot_model in config/instances/robot.ini.
# SYNCAI_DDS_CONFIG=models/m20/cyclonedds.xml

# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=syncai

# ── pgAdmin ──
PGADMIN_DEFAULT_EMAIL=admin@syncai.com
PGADMIN_DEFAULT_PASSWORD=changeme

# ── Temporal ──
# Schema plugin + connection to the shared postgres (reuses POSTGRES_USER / POSTGRES_PASSWORD).
TEMPORAL_DB=postgres12
TEMPORAL_DB_PORT=5432
TEMPORAL_POSTGRES_SEEDS=postgres

# Temporal UI → frontend wiring
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_CORS_ORIGINS=http://localhost:3000
