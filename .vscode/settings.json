{
  // 切換焦點時自動存檔 —— 這個模式才會觸發 formatOnSave
  // (afterDelay 打字自動存不會套用格式)
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": true,
  // 用 clang-format,並讀取 repo 根目錄的 .clang-format 設定
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_style": "file",
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  // syncai_ros_mcp 用 uv 管理，venv 在 submodule 底下 (uv sync 產生)。
  // 根 workspace 的 ${workspaceFolder} 是 /workspace，所以要指到完整相對路徑。
  // "python.defaultInterpreterPath": "${workspaceFolder}/src/syncai_ros_mcp/.venv/bin/python",
  "python.autoComplete.extraPaths": [
    "/opt/ros/humble/lib/python3.10/site-packages",
    "/opt/ros/humble/local/lib/python3.10/dist-packages",
    "${workspaceFolder}/src/syncai_ros_mcp/src"
  ],
  "python.analysis.extraPaths": [
    "/opt/ros/humble/lib/python3.10/site-packages",
    "/opt/ros/humble/local/lib/python3.10/dist-packages",
    "${workspaceFolder}/src/syncai_ros_mcp/src"
  ],
  "ROS2.distro": "humble",
  "cmake.sourceDirectory": "/home/syncrobotic/Documents/SyncAI-Robot-Workspace/src/syncai_map_server"
}