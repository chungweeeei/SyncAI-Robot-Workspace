{
  // Auto-save on focus change -- this is the only autoSave mode that triggers
  // formatOnSave (afterDelay saves while typing and does not apply formatting)
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": true,
  // Use clang-format, reading the .clang-format config at the repo root
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_style": "file",
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "python.autoComplete.extraPaths": [
    "/opt/ros/humble/lib/python3.10/site-packages",
    "/opt/ros/humble/local/lib/python3.10/dist-packages"
  ],
  "python.analysis.extraPaths": [
    "/opt/ros/humble/lib/python3.10/site-packages",
    "/opt/ros/humble/local/lib/python3.10/dist-packages"
  ],
  "ROS2.distro": "humble",
  "cmake.sourceDirectory": "/home/syncrobotic/SyncAI-Robot-Workspace/src/syncai_map_server"
}