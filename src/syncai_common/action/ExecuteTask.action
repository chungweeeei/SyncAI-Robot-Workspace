# === Goal ===
# Unique identifier of this task, identical to the backend / REST task_id (e.g. uuid4().hex).
string uuid
# Time the backend / client issued the request (Unix epoch, milliseconds).
int64 timestamp
# The complete BehaviorTree XML to load and tick (an inline string, not a file path).
string behavior_tree
---
# === Result ===
# Final outcome of the tree execution.
bool success
# Human-readable detail (the error message on failure, a summary on success).
string message
# Time the tree finished (Unix epoch, milliseconds).
int64 finished_timestamp
---
# === Feedback ===
# Current execution status, e.g. "RUNNING".
string status
# Milliseconds elapsed since ticking began.
int64 elapsed_ms
