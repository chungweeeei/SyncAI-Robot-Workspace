<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>syncai_mapping</name>
  <version>0.0.0</version>
  <description>
    The mapping back end. pgo_node: pose-graph optimisation over
    syncai_pointlio's odometry and body clouds -- keyframes, loop closure
    (GTSAM iSAM2), the map -&gt; pointlio_odom correction TF, the "map so far"
    hand-off to the operator console, and the save_maps / reset_mapping
    services that bracket a mapping run. hba_node: offline hierarchical
    bundle adjustment (HBA / BALM) over the patches save_maps wrote, run by
    hand. Both ported from SyncAI-Fast-LIO2 (`pgo`, `hba`; liangheming/
    FASTLIO2_ROS2 lineage) in 2026-09.
  </description>
  <maintainer email="chungweeeei@gmail.com">andy_tseng</maintainer>
  <!-- MIT, not Apache-2.0 like the other syncai_* packages: pgos/ and hba/
       are upstream-derived, and the LICENSE file is theirs. -->
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>message_filters</depend>
  <!-- SaveMaps, ResetMapping, RefineMap and SavePoses (served here) and
       ResetLIO (the client into syncai_pointlio). The workspace-wide
       interface package, materialised by `vcs import < interface.repos`;
       the services moved there from SyncAI-Fast-LIO2's `interface` with
       these nodes, because the backend builds against syncai_common. -->
  <depend>syncai_common</depend>

  <!-- Not listed on purpose: PCL, Eigen, GTSAM and Sophus. PCL / Eigen arrive
       through pcl_conversions' own rosdep chain (libpcl-dev, libeigen3-dev).
       GTSAM (both nodes) and Sophus (hba_node) have no rosdep key matching
       what the robot image ships -- source-built into /usr/local by the
       Dockerfile's deps-builder stage -- and scripts/build.sh runs
       `rosdep check`, so a key here would only add the "cannot locate" line
       the fork's `<depend>GTSAM</depend>` used to produce. Same treatment
       syncai_pointlio gives Sophus. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
