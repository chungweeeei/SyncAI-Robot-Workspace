<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>syncai_localizer</name>
  <version>0.0.0</version>
  <description>
    Map-based relocalization for the navigation session: two-stage GICP
    (small_gicp, rough then refine) of syncai_pointlio's body cloud against
    the saved map.pcd, broadcasting the map -&gt; pointlio_odom correction
    and serving relocalize / relocalize_check, with initialpose and the
    INI's [initial_pose] as the other two guess paths. Ported from
    SyncAI-Fast-LIO2's `localizer` package (liangheming/FASTLIO2_ROS2
    lineage) in 2026-09, the last node left in that fork.
  </description>
  <maintainer email="chungweeeei@gmail.com">andy_tseng</maintainer>
  <!-- MIT, not Apache-2.0 like the other syncai_* packages: localizers/ is
       upstream-derived, and the LICENSE file is theirs. -->
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <!-- Relocalize / IsValid (served here). The workspace-wide interface
       package, materialised by `vcs import < dependencies.repos`; the backend,
       the only caller of both, builds against it. -->
  <depend>syncai_common</depend>
  <!-- The registration backend. Not a rosdep key: src/third-party/small_gicp
       ships its own package.xml (build_type cmake), so a `rosdep` run with `ignore-src`
       skips it and this line is what makes colcon build it before us. -->
  <depend>small_gicp</depend>

  <!-- Not listed on purpose: PCL and Eigen, which arrive through
       pcl_conversions' own rosdep chain (libpcl-dev, libeigen3-dev). Nothing
       here needs GTSAM, Sophus or yaml-cpp. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
