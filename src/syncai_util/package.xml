<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>syncai_util</name>
  <version>0.0.0</version>
  <description>Shared helpers (geometry, occupancy-grid values, odometry window, action server, path heights, the stair state machine) for the syncai nav packages</description>
  <maintainer email="chungweeeei@gmail.com">ros</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <!-- StairMode (stair_mode.hpp): the SetPolicyMode service and the mode /
       stair_mode messages. syncai_common is vcs-imported from
       SyncAI-Robot-Interface (dependencies.repos). -->
  <depend>std_msgs</depend>
  <depend>syncai_common</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
