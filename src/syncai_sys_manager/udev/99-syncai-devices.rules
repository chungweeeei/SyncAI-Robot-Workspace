# udev rules for the SyncAI robot's hot-pluggable peripherals.
#
# udev runs on the HOST, not in the robot container — install these there:
#
#   sudo cp src/syncai_sys_manager/udev/99-syncai-devices.rules /etc/udev/rules.d/
#   sudo udevadm control --reload
#   sudo udevadm trigger
#
# The robot container gets the raw /dev/videoN nodes via docker-compose device
# passthrough; the /dev/syncai/* symlinks created here live on the host and are
# what the compose file (and any host-side tooling) should reference, so the
# passthrough no longer depends on kernel enumeration order.

# ── Cameras ──────────────────────────────────────────────────────────────────
# Two TechNexion UVC cameras, and they are NOT the same model:
#
#   3407:57d1  VCS-AR0234-C → camera0   (1920x1200 max, today's /dev/video0)
#   3407:0144  VCI-AR0144-C → camera1   (1280x800  max, today's /dev/video2)
#
# So the match is on vendor/product ID. An earlier version of these rules keyed
# on the USB port path instead (KERNELS=="2-3.1" / "2-3.4"), on the assumption
# that both units were VCS-AR0234-C and only the port could tell them apart.
# Both halves of that turned out wrong and the rules silently matched nothing —
# no /dev/syncai/camera* at all, while the speaker rules below worked fine:
# the second unit is a different model, and the cameras are no longer behind
# the hub the 2-3.x paths described (they sit directly on 2-1 / 2-2 today).
# Product IDs also survive a re-cable, which the port path does not — and the
# port path was never the property we actually cared about.
#
# Should the fleet ever carry two units of the SAME model, port-path or serial
# matching comes back for that pair; keep this file the place that decision is
# recorded.
#
# The differing sensors are load-bearing, not trivia: the two cameras have
# different maximum resolutions and frame rates, so they are not interchangeable
# left/right halves of a pair. The model alias on each line exists so a consumer
# can say which sensor it wants without having to know the numbering.
#
# Each UVC camera exposes TWO video4linux nodes: index 0 is the actual video
# capture node, index 1 is a UVC metadata node that produces no frames. That
# is why /dev/video1 and /dev/video3 exist but are useless as cameras — the
# ATTR{index}=="0" match below skips the metadata nodes so the symlinks can
# never land on one.
SUBSYSTEM=="video4linux", ATTR{index}=="0", ATTRS{idVendor}=="3407", ATTRS{idProduct}=="57d1", SYMLINK+="syncai/camera0", SYMLINK+="syncai/camera_ar0234"
SUBSYSTEM=="video4linux", ATTR{index}=="0", ATTRS{idVendor}=="3407", ATTRS{idProduct}=="0144", SYMLINK+="syncai/camera1", SYMLINK+="syncai/camera_ar0144"

# ── Speaker ──────────────────────────────────────────────────────────────────
# USB audio dongle (Jieli CD002-AUDIO, e2b8:0811). Its ALSA card number is
# whatever enumerates after the Tegra HDA/APE cards (card 2 today) and is not
# guaranteed stable, but the card *name* "CD002AUDIO" is derived from the USB
# descriptor and is — so audio consumers (e.g. the backend TTS gateway) should
# open it as ALSA device "hw:CARD=CD002AUDIO" / "plughw:CARD=CD002AUDIO"
# rather than by number. The symlinks below exist for presence detection and
# for recovering the current card number without parsing aplay output: the
# link target's name embeds it (controlC<N> / pcmC<N>D0p).
SUBSYSTEM=="sound", KERNEL=="controlC[0-9]*", SUBSYSTEMS=="usb", ATTRS{idVendor}=="e2b8", ATTRS{idProduct}=="0811", SYMLINK+="syncai/speaker"
SUBSYSTEM=="sound", KERNEL=="pcmC[0-9]*D0p", SUBSYSTEMS=="usb", ATTRS{idVendor}=="e2b8", ATTRS{idProduct}=="0811", SYMLINK+="syncai/speaker_pcm"
