<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>syncai_ros_mcp</name>
  <version>0.1.0</version>
  <description>MCP (Model Context Protocol) server exposing ROS 2 introspection and control as tools, running as a ROS 2 node.</description>
  <maintainer email="chungweeeei@gmail.com">chungweeeei</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>rosidl_runtime_py</depend>
  <depend>python3-requests</depend>

  <!--
    fastmcp is a pip-only dependency (not in rosdep). Install it into the same
    Python interpreter that runs the node:
        pip install fastmcp
    See README / setup.py install_requires.
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
