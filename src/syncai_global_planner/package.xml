<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>syncai_global_planner</name>
  <version>0.0.0</version>
  <description>Global planner action server ported from nav2_planner to a non-lifecycle rclcpp::Node, with the NavFn planner plugin (from nav2_navfn_planner), the Smac planner family (from nav2_smac_planner) and the OctoMap surface planner for the quadruped (OctomapPlanner3D) merged into the same package</description>
  <maintainer email="chungweeeei@gmail.com">syncrobotic</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>pluginlib</depend>
  <depend>syncai_util</depend>
  <depend>syncai_costmap_2d</depend>
  <depend>syncai_nav_core</depend>

  <!-- smac planner deps, same rosdep keys upstream nav2_smac_planner uses.
       ompl resolves to ros-humble-ompl (also added to the Dockerfile base
       stage — a hand-installed copy would be wiped on container recreation).
       It stays required after the Hybrid-A* planner was dropped, because the
       smoother resamples path boundaries through a Dubins state space. -->
  <depend>angles</depend>
  <depend>eigen</depend>
  <depend>ompl</depend>

  <!-- OctomapPlanner3D reads map/<name>/octomap.bt (octomap::OcTree). The
       same rosdep key syncai_mapping's clean_map uses; the image's dev stage
       installs ros-humble-octomap for it. -->
  <depend>octomap</depend>
  <!-- OctomapPlanner3D's keepout zones (map/<name>/keepout.json) are parsed
       with nlohmann-json, header-only (apt nlohmann-json3-dev; the key
       syncai_localizer and syncai_mapping use too). -->
  <depend>nlohmann-json-dev</depend>

  <!-- OctomapPlanner3D's dynamic-obstacle overlay (2026-10-21) subscribes
       the lidar cloud through a TF message filter and transforms it into the
       map frame, the way the costmap's obstacle and terrain layers do. -->
  <depend>sensor_msgs</depend>
  <depend>message_filters</depend>
  <depend>tf2_sensor_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <syncai_nav_core plugin="${prefix}/global_planner_plugin.xml" />
  </export>
</package>
