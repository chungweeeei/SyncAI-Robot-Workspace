<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>syncai_m20_joint_state</name>
  <version>0.1.0</version>
  <description>
    Republishes the Lynx M20's leg and wheel angles (the vendor's /JOINTS_DATA) as
    sensor_msgs/JointState in M20.urdf's joint convention, for robot_state_publisher
  </description>
  <maintainer email="chungweeeei@gmail.com">chungweeeei</maintainer>
  <license>Apache-2.0</license>

  <depend>rclrs</depend>
  <depend>rosidl_runtime_rs</depend>
  <!-- DEEP Robotics' message types: src/third-party/sdk_deploy/src/drdds,
       from third-party-sparse.repos (scripts/sparse_import.sh) -->
  <depend>drdds</depend>
  <depend>builtin_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
