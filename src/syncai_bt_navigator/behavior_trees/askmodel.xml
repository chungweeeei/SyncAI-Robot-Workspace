<!--
  AskModel BT 骨架 —— 示範「同一棵樹裡 action + service 混用」。

  Sequence：先用 service 印一行 log，再用 action 去問模型，最後再 service 印結果。
    <Printout>  : BT::RosServiceNode<Printout> —— 瞬間完成，呼叫一次就回 SUCCESS/FAILURE
    <AskModel>  : BT::RosActionNode<Askmodel> —— 長任務，執行期間持續回 RUNNING

  {question} / {answer} 是 blackboard key：
    - {question} 由 AskModelBtRunner::onGoalReceived() 從 goal 寫入
    - {answer}   由 <AskModel> 葉節點寫回，onCompletion() 再搬進 action result

  TODO: 這兩個自訂 tag 需要對應的 BT plugin 葉節點存在並被載入
        （見 askmodel_bt_runner.cpp 的 plugin_libs），否則載入此 XML 會丟例外。
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="AskModelFlow">
      <Printout text="Start ask question to Large Language Model"/>
      <AskModel server_name="ask_model" question="{question}" answer="{answer}" success="{success}"/>
      <Printout text="{answer}"/>
    </Sequence>
  </BehaviorTree>
</root>


<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateWithReplanning">
      <RateController hz="1.0">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
