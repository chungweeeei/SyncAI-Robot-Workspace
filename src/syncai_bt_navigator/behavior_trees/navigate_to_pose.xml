<!--
  Minimal navigate-to-pose behavior tree.

  Uses only the action plugins ported so far (ComputePathToPose, FollowPath)
  plus the BehaviorTree.CPP built-in Sequence control node. It computes a path
  to the goal then follows it once. There is no replanning loop and no recovery
  behaviors yet - if either step fails, the tree fails.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="NavigateMinimal">
      <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
      <FollowPath path="{path}" controller_id="FollowPath"/>
    </Sequence>
  </BehaviorTree>
</root>
