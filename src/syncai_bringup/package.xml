<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>syncai_bringup</name>
  <version>0.0.0</version>
  <description>Sensing and TF bringup for the SyncAI navigation stack: the G23 robot description plus the Livox MID360 driver</description>
  <maintainer email="chungweeeei@gmail.com">ros</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- bringup.launch.py: robot_state_publisher over description/G23.urdf, plus
       the MID360 driver. The launch file no longer touches the
       livox_ros_driver2 share directory (it generates its own MID360 config
       JSON), so this is now a plain runtime dep on the node executable.

       python3-yaml is used by the launch file itself, to read host_ip back out
       of params/bringup.yaml when rendering that JSON.

       ros2_laser_scan_merger / tf2_ros used to be listed here for the removed
       bringup_2d.launch.py (scan merger + base_link -> scan static TF). -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
