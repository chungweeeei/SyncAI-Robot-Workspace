<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>syncai_bringup</name>
  <version>0.0.0</version>
  <description>Sensing and TF bringup for the SyncAI navigation stack: the G23 robot description, the Livox MID360 driver, and the optional VizionSDK camera</description>
  <maintainer email="chungweeeei@gmail.com">ros</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- bringup.launch.py: robot_state_publisher over description/G23.urdf, plus
       the MID360 driver. The launch file no longer touches the
       livox_ros_driver2 share directory (it generates its own MID360 config
       JSON), so this is now a plain runtime dep on the node executable.

       python3-yaml is used by the launch file itself, to read host_ip back out
       of params/bringup.yaml when rendering that JSON.

       ros2_laser_scan_merger / tf2_ros used to be listed here for the removed
       bringup_2d.launch.py (scan merger + base_link -> scan static TF). -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- The VizionSDK camera node, started only under use_camera:=true. An
       exec_depend and not a depend: nothing here compiles against it, the
       launch file just names the executable. It stays listed even though the
       node is off by default, because rosdep and the colcon build order are
       what get vizionsdk_ros2 built before anything tries to launch it.

       Note that rosdep cannot install what vizionsdk_ros2 itself needs. The
       TechNexion VizionSDK it links against has no rosdep key and lives in no
       distro repo — it is installed from a .deb in the Dockerfile, so a
       workspace built outside that image fails at configure with
       "No package 'vizionsdk' found". -->
  <exec_depend>vizionsdk_ros2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
