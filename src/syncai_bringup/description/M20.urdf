    <!-- CA9B sensor frames. Translations are converted from millimeters to meters.
         The source document specifies no additional rotation for these sensors. -->
    <link name="front_camera_link"/>
    <joint name="front_camera_joint" type="fixed">
        <origin xyz="0.37646 0 0.03738" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="front_camera_link"/>
    </joint>

    <link name="rear_camera_link"/>
    <joint name="rear_camera_joint" type="fixed">
        <origin xyz="-0.37646 0 0.03738" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="rear_camera_link"/>
    </joint>

    <!-- Lidar and IMU frames, copied from the vendor stack's /tf_static as
         captured on robot01 on 2026-11-24 (published by its domain_bridge_0 on
         domain 0, unprefixed, every child of base_link). They are under the
         vendor's names, not the G23's lidar_top / lidar_top_imu, because they
         are not the same thing: lidar_link is not one lidar but the frame the
         vendor merges both into, and imu is the body's IMU, not a lidar's.

         lidar_link: identity on base_link. /LIDAR/POINTS_UDP is stamped
         "lidar_link", and the vendor puts it at base_link's origin, so the
         merged cloud is already in the body frame. This one is evidenced by
         the data, not only by the vendor's TF.

         imu: (0.0632, -0.0268, 0.0435), no rotation - not from that
         /tf_static (whose "imu", (-0.026, 0, 0.042), this was until the same
         day) but from DEEP Robotics' own MJCF of the M20 (sdk_deploy's
         M20_description/m20_mjcf/mjcf/M20.xml), where the accelerometer and
         gyro sit on imu_site at that point of base_link; their controller is
         simulated on it. The /tf_static tree is an integrator's template
         (robotPF's layout.urdf: other vendors' frame names, frames with
         identical values, 1.57 / 3.14 for pi / 2 and pi), with an "imu_link"
         at the origin and a "utlidar_imu" turned by pi besides. Not measured
         on the robot; /IMU is stamped with an empty frame_id. syncai_pointlio's
         params/models/m20.yaml carries the inverse as r_il / t_il: change the
         two together.

         Its rpy since 2026-11-26 (0 until then): the IMU's axes turned by
         roll +0.39 deg, pitch -0.47 deg against base_link, the transpose of
         m20.yaml's r_il, which was fitted from motion on the dp_1125 bag
         (gyro against the cloud's rotation; m20.yaml has the fit and its
         caveats). Point-LIO's body frame is this IMU, so syncai_lio_bridge
         closes base_link through it and an unrotated joint here would tilt
         base_link by the same ~0.6 deg. -->
    <link name="lidar_link"/>
    <joint name="lidar_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="lidar_link"/>
    </joint>

    <link name="imu"/>
    <joint name="imu_joint" type="fixed">
        <origin xyz="0.0632 -0.0268 0.0435" rpy="0.006807 -0.008203 -0.000028"/>
        <parent link="base_link"/>
        <child link="imu"/>
    </joint>
</robot>
