<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>syncai_backend</name>
  <version>0.0.0</version>
  <description>Robot backend node exposing a RESTful API (FastAPI) bridged to ROS 2</description>
  <maintainer email="chungweeeei@gmail.com">ros</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!--
    Generated interfaces this package imports at runtime (syncai_common.msg /
    .srv). Declaring it also gives colcon a reason to build syncai_common
    before this package instead of relying on the whole install space being
    sourced.
  -->
  <exec_depend>syncai_common</exec_depend>
  <!--
    FASTLIO2_ROS2's interface package (yes, it is genuinely named `interface`):
    the map gateway imports interface.srv.SaveMaps to trigger pgo's map save.
    Same rationale as syncai_common above — build ordering plus honesty about
    a runtime import.
  -->
  <exec_depend>interface</exec_depend>

  <!--
    Web stack (FastAPI + uvicorn) is installed via pip / requirements.txt, not
    rosdep, because Ubuntu 22.04 (jammy) has no reliable apt/rosdep key for
    fastapi. See requirements.txt and the README for setup.

    kokoro-onnx (the TTS gateway's engine) is in the same boat: pip-only, no
    rosdep key — same precedent as fastmcp in syncai_ros_mcp. It also needs
    model weights that are NOT pip-installed: ~/robot_ws/models/kokoro/
    (gitignored; download URLs in gateways/tts/tts.py). The /speak route
    additionally needs aplay (alsa-utils, Dockerfile dev stage) and /dev/snd
    passed into the container (docker-compose.robots.yml).
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
