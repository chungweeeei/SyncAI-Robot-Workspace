<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>syncai_backend</name>
  <version>0.0.0</version>
  <description>Robot backend node exposing a RESTful API (FastAPI) bridged to ROS 2</description>
  <maintainer email="chungweeeei@gmail.com">ros</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!--
    Web stack (FastAPI + uvicorn) is installed via pip / requirements.txt, not
    rosdep, because Ubuntu 22.04 (jammy) has no reliable apt/rosdep key for
    fastapi. See requirements.txt and the README for setup.
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
